<Window x:Class="MontaWin.Montador.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MontaWin" Width="1100" Height="800" MinWidth="640" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="#160A44">
  <!-- Cores do tema (Painel, BordaPainel, Cartao, Borda, Destaque) são trocadas em AplicarTema. -->
  <Window.Resources>
    <Style x:Key="Cartao" TargetType="Border">
      <Setter Property="Padding" Value="18" />
      <Setter Property="Margin" Value="0,0,0,12" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource Borda}" />
      <Setter Property="Background" Value="{DynamicResource Cartao}" />
    </Style>
    <Style x:Key="Titulo" TargetType="TextBlock">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style x:Key="Dica" TargetType="TextBlock">
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Principal" TargetType="Button">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Fundo" Background="{DynamicResource Destaque}" CornerRadius="10" Padding="28,11">
              <ContentPresenter HorizontalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Fundo" Property="Opacity" Value="0.88" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Fundo" Property="Opacity" Value="0.4" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <!-- Fundos no estilo do painel (mesmos desenhos da prévia), esticados para cobrir a janela -->
    <Viewbox x:Name="FundoOndas" Stretch="UniformToFill">
      <Canvas Width="1280" Height="720" ClipToBounds="True">
        <Rectangle Width="1280" Height="720">
          <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#1A0B52" /><GradientStop Color="#131C6E" Offset="1" /></LinearGradientBrush></Rectangle.Fill>
        </Rectangle>
        <Path Data="M560 0 C 700 90 820 40 940 150 S 1150 230 1280 300 L 1280 0 Z" Opacity="0.9">
          <Path.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#2346B8" /><GradientStop Color="#1E7FE0" Offset="1" /></LinearGradientBrush></Path.Fill>
        </Path>
        <Path Data="M780 0 C 900 120 1040 70 1130 200 S 1240 330 1280 360 L 1280 0 Z" Fill="#2B8CF0" Opacity="0.55" />
        <Path Data="M0 380 C 160 300 330 330 470 300 S 760 220 900 260 S 1150 380 1280 420 L 1280 720 L 0 720 Z" Opacity="0.9">
          <Path.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#2A0E72" /><GradientStop Color="#1A1366" Offset="1" /></LinearGradientBrush></Path.Fill>
        </Path>
        <Path Data="M0 470 C 120 400 260 420 360 460 S 560 520 640 600 S 760 700 800 720 L 0 720 Z" Opacity="0.85">
          <Path.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#B0157E" /><GradientStop Color="#3A0C5E" Offset="1" /></LinearGradientBrush></Path.Fill>
        </Path>
        <Path Data="M0 540 C 90 500 200 490 280 530 S 420 640 470 720 L 0 720 Z">
          <Path.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F0288F" /><GradientStop Color="#6A0C78" Offset="1" /></LinearGradientBrush></Path.Fill>
        </Path>
      </Canvas>
    </Viewbox>

    <Viewbox x:Name="FundoBloom" Stretch="UniformToFill" Visibility="Collapsed">
      <Canvas Width="1280" Height="720" ClipToBounds="True">
        <Rectangle Width="1280" Height="720">
          <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#050C24" /><GradientStop Color="#10307A" Offset="1" /></LinearGradientBrush></Rectangle.Fill>
        </Rectangle>
        <Ellipse Canvas.Left="290" Canvas.Top="50" Width="700" Height="700" Fill="#3D7BFF" Opacity="0.45">
          <Ellipse.Effect><BlurEffect Radius="160" /></Ellipse.Effect>
        </Ellipse>
        <Canvas Canvas.Left="640" Canvas.Top="420">
          <Canvas.Effect><BlurEffect Radius="28" /></Canvas.Effect>
          <Canvas.Resources>
            <LinearGradientBrush x:Key="Petala" StartPoint="0,0" EndPoint="1,0">
              <GradientStop Color="#E6E3F2FF" /><GradientStop Color="#BF4C8DFF" Offset="0.45" /><GradientStop Color="#1A1846C4" Offset="1" />
            </LinearGradientBrush>
            <Style TargetType="Ellipse">
              <Setter Property="Width" Value="460" /><Setter Property="Height" Value="160" />
              <Setter Property="Canvas.Left" Value="-30" /><Setter Property="Canvas.Top" Value="-80" />
              <Setter Property="RenderTransformOrigin" Value="0.065,0.5" />
              <Setter Property="Fill" Value="{StaticResource Petala}" />
            </Style>
          </Canvas.Resources>
          <Ellipse><Ellipse.RenderTransform><RotateTransform Angle="-150" /></Ellipse.RenderTransform></Ellipse>
          <Ellipse><Ellipse.RenderTransform><RotateTransform Angle="-110" /></Ellipse.RenderTransform></Ellipse>
          <Ellipse><Ellipse.RenderTransform><RotateTransform Angle="-70" /></Ellipse.RenderTransform></Ellipse>
          <Ellipse><Ellipse.RenderTransform><RotateTransform Angle="-30" /></Ellipse.RenderTransform></Ellipse>
          <Ellipse><Ellipse.RenderTransform><RotateTransform Angle="10" /></Ellipse.RenderTransform></Ellipse>
          <Ellipse><Ellipse.RenderTransform><RotateTransform Angle="170" /></Ellipse.RenderTransform></Ellipse>
          <Ellipse><Ellipse.RenderTransform><RotateTransform Angle="210" /></Ellipse.RenderTransform></Ellipse>
        </Canvas>
      </Canvas>
    </Viewbox>

    <Viewbox x:Name="FundoPastel" Stretch="UniformToFill" Visibility="Collapsed">
      <Canvas Width="1280" Height="720" ClipToBounds="True" Background="#E9ECF8">
        <Canvas>
          <Canvas.Effect><BlurEffect Radius="72" /></Canvas.Effect>
          <Polygon Points="720,150 1150,120 1280,520 820,600" Fill="#2E86F0" Opacity="0.8" />
          <Polygon Points="480,220 900,180 980,560 520,620" Fill="#3E5BEA" Opacity="0.75" />
          <Polygon Points="300,380 760,300 900,720 200,720" Fill="#7B2CF0" Opacity="0.8" />
          <Polygon Points="80,560 620,470 760,720 40,720" Fill="#D32EE6" Opacity="0.85" />
          <Ellipse Canvas.Left="20" Canvas.Top="-100" Width="440" Height="440" Fill="White" Opacity="0.8" />
        </Canvas>
      </Canvas>
    </Viewbox>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <Border Background="{DynamicResource Painel}" BorderBrush="{DynamicResource BordaPainel}" BorderThickness="1" CornerRadius="22"
              MaxWidth="720" Margin="24,32" Padding="30,26" VerticalAlignment="Center">
        <Border.Effect><DropShadowEffect BlurRadius="60" ShadowDepth="16" Opacity="0.4" /></Border.Effect>
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
            <Border Width="46" Height="46" CornerRadius="14" Background="{DynamicResource Destaque}" Margin="0,0,14,0">
              <TextBlock Text="M" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="MontaWin" FontSize="26" FontWeight="SemiBold" />
              <TextBlock Style="{StaticResource Dica}" Text="Cria o pendrive de implantação: o PC dá boot e abre direto o painel MontaWin." />
            </StackPanel>
          </StackPanel>

          <Border Style="{StaticResource Cartao}">
            <StackPanel>
              <TextBlock Style="{StaticResource Titulo}" Text="1 · Imagem do Windows" />
              <DockPanel>
                <Button x:Name="BotaoIso" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="14,6" Content="Escolher ISO..." Click="EscolherIso" />
                <TextBox x:Name="CaminhoIso" IsReadOnly="True" VerticalContentAlignment="Center" />
              </DockPanel>
              <TextBlock x:Name="TituloEdicoes" Text="Edições que vão para o pendrive (escolhidas no painel na hora de instalar)"
                         Style="{StaticResource Dica}" Margin="0,14,0,6" Visibility="Collapsed" />
              <ItemsControl x:Name="ListaEdicoes" Margin="0,0,0,12">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <CheckBox Content="{Binding Nome}" IsChecked="{Binding Marcada}" Margin="0,2" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Style="{StaticResource Dica}" Margin="0,0,0,6"
                         Text="Atualizações do mês (opcional): pasta com os arquivos .msu baixados do Microsoft Update Catalog, da mesma versão da ISO." />
              <DockPanel>
                <Button x:Name="BotaoAtualizacoes" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="14,6" Content="Escolher pasta..." Click="EscolherAtualizacoes" />
                <TextBox x:Name="PastaAtualizacoes" IsReadOnly="True" VerticalContentAlignment="Center" />
              </DockPanel>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Cartao}">
            <StackPanel>
              <TextBlock Style="{StaticResource Titulo}" Text="2 · Pendrive" />
              <DockPanel>
                <Button x:Name="BotaoAtualizar" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="14,6" Content="Atualizar" Click="Atualizar" />
                <ComboBox x:Name="ListaPendrives" DisplayMemberPath="Descricao" SelectionChanged="PendriveEscolhido" />
              </DockPanel>
              <CheckBox x:Name="Manter" Margin="0,10,0,0" Visibility="Collapsed" IsChecked="True">
                <TextBlock TextWrapping="Wrap" Text="Manter o que já está no pendrive: só adiciona esta ISO e atualiza o painel (imagens e backups ficam)" />
              </CheckBox>
              <TextBlock Style="{StaticResource Dica}" Margin="0,8,0,0"
                         Text="Use um pendrive de 16 GB ou mais. Na primeira vez, tudo o que estiver nele é apagado. Só aparecem discos USB." />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Cartao}">
            <StackPanel>
              <TextBlock Style="{StaticResource Titulo}" Text="3 · Visual do painel" />
              <TextBlock Style="{StaticResource Dica}" Margin="0,0,0,10" Text="O tema que você escolher aqui é o que aparece no PC quando ele der boot pelo pendrive." />
              <UniformGrid x:Name="Temas" Columns="3">
                <RadioButton GroupName="Tema" Tag="ondas" IsChecked="True" Checked="TemaEscolhido" Margin="0,0,8,0">
                  <StackPanel>
                    <Border Height="54" Width="110" CornerRadius="8" HorizontalAlignment="Left">
                      <Border.Background><LinearGradientBrush StartPoint="0,1" EndPoint="1,0"><GradientStop Color="#F0288F" /><GradientStop Color="#2A0E72" Offset="0.5" /><GradientStop Color="#1E7FE0" Offset="1" /></LinearGradientBrush></Border.Background>
                    </Border>
                    <TextBlock Text="Ondas" Margin="0,6,0,0" />
                  </StackPanel>
                </RadioButton>
                <RadioButton GroupName="Tema" Tag="bloom" Checked="TemaEscolhido" Margin="0,0,8,0">
                  <StackPanel>
                    <Border Height="54" Width="110" CornerRadius="8" HorizontalAlignment="Left">
                      <Border.Background><RadialGradientBrush Center="0.5,0.65" GradientOrigin="0.5,0.65"><GradientStop Color="#9FC4FF" /><GradientStop Color="#2A5BD8" Offset="0.5" /><GradientStop Color="#050C24" Offset="1" /></RadialGradientBrush></Border.Background>
                    </Border>
                    <TextBlock Text="Bloom" Margin="0,6,0,0" />
                  </StackPanel>
                </RadioButton>
                <RadioButton GroupName="Tema" Tag="pastel" Checked="TemaEscolhido">
                  <StackPanel>
                    <Border Height="54" Width="110" CornerRadius="8" HorizontalAlignment="Left">
                      <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F4F5FC" /><GradientStop Color="#7B8BF0" Offset="0.55" /><GradientStop Color="#D32EE6" Offset="1" /></LinearGradientBrush></Border.Background>
                    </Border>
                    <TextBlock Text="Pastel" Margin="0,6,0,0" />
                  </StackPanel>
                </RadioButton>
              </UniformGrid>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Cartao}">
            <StackPanel>
              <TextBlock Style="{StaticResource Titulo}" Text="4 · Criar" />
              <CheckBox x:Name="Rapida" Margin="0,0,0,14">
                <TextBlock TextWrapping="Wrap" Text="Instalação mais rápida (imagem ~30% maior; ideal para pendrive USB 3.0 ou SSD externo)" />
              </CheckBox>
              <Button x:Name="BotaoCriar" Style="{StaticResource Principal}" Content="Criar pendrive" HorizontalAlignment="Left" Click="Criar" />
              <ProgressBar x:Name="Barra" Height="6" Margin="0,16,0,6" Maximum="100" Foreground="{DynamicResource Destaque}" />
              <TextBlock x:Name="Status" Style="{StaticResource Dica}" Text="Escolha a ISO e o pendrive." />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
    </ScrollViewer>
  </Grid>
</Window>
