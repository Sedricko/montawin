<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>MontaWin.Montador</RootNamespace>
    <AssemblyName>AuroraWin</AssemblyName>
    <Product>Aurora Win</Product>
    <!-- Ícone claro: o app do PC do técnico (a janela usa o mesmo ícone do exe) -->
    <ApplicationIcon>MontaWin.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WPF0001: o tema Fluent (Windows 11) ainda é marcado como experimental -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <!-- O WPF tira System.IO dos usings implícitos (conflito de Path com Shapes); aqui não usamos Shapes. -->
  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <!-- Um exe só: o painel do pendrive (publicado antes, em Native AOT) vai embutido. Sem ele, procura ao lado do exe. -->
  <PropertyGroup>
    <PainelExe Condition="'$(PainelExe)' == ''">$(MSBuildThisFileDirectory)..\..\publicar\Implantador.exe</PainelExe>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(PainelExe)" LogicalName="Implantador.exe" Condition="Exists('$(PainelExe)')" />
    <EmbeddedResource Include="icone-painel.png" LogicalName="icone.png" />
    <Resource Include="icone-app.png" />
  </ItemGroup>

  <!-- Mesma leitura de discos, .wim e execução de comandos do Implantador -->
  <ItemGroup>
    <Compile Include="..\Implantador\Comandos.cs;..\Implantador\Discos.cs;..\Implantador\Programas.cs;..\Implantador\Saude.cs;..\Implantador\Wim.cs;..\Implantador\Unattend.cs;..\Implantador\Perfil.cs" LinkBase="Compartilhado" />
  </ItemGroup>

</Project>
